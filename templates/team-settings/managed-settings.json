      "Edit(~/.git-credentials)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.config/rclone/**)",
      "Edit(~/.config/rclone/**)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Grep(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Grep(**/.env.*)",
      "Read(**/secrets/**)",
