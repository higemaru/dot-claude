      "Edit(~/.zshrc)",
      "Read(~/.zshenv)",
      "Edit(~/.zshenv)",
      "Read(~/.profile)",
      "Edit(~/.profile)",
      "Read(~/.zprofile)",
      "Edit(~/.zprofile)",
      "Read(~/.bash_profile)",
      "Edit(~/.bash_profile)",
      "Read(~/.bash_history)",
      "Edit(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Edit(~/.zsh_history)",
      "Read(~/.python_history)",
      "Edit(~/.python_history)",
      "Read(~/.lesshst)",
