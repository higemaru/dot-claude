{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "Japanese",
  "cleanupPeriodDays": 365,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_BUG_COMMAND": "1"
  },
  "_dummy_key_forceLoginOrgUUID": [],
  "forceLoginMethod": "claudeai",
  "_dummy_key_allowManagedHooksOnly": true,
  "_dummy_key_allowManagedMcpServersOnly": true,
  "allowedMcpServers": [],
  "disableSkillShellExecution": true,
  "permissions": {
    "_dummy_key_autoApprove": "never",
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Bash(rm *)",
      "Bash(sudo *)"
    ],
    "deny": [
      "WebSearch",
      "WebFetch",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.claude.json)",
      "Edit(~/.claude.json)",
      "Read(~/.boto)",
      "Edit(~/.boto)",
      "Read(~/.bashrc)",
      "Edit(~/.bashrc)",
      "Read(~/.zshrc)",
      "Edit(~/.zshrc)",
      "Read(~/.zshenv)",
      "Edit(~/.zshenv)",
      "Read(~/.profile)",
      "Edit(~/.profile)",
      "Read(~/.zprofile)",
      "Edit(~/.zprofile)",
      "Read(~/.bash_profile)",
      "Edit(~/.bash_profile)",
      "Read(~/.bash_history)",
      "Edit(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Edit(~/.zsh_history)",
      "Read(~/.python_history)",
      "Edit(~/.python_history)",
      "Read(~/.lesshst)",
      "Edit(~/.lesshst)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.azure/**)",
      "Edit(~/.azure/**)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/.git-credentials)",
      "Edit(~/.git-credentials)",
      "Read(~/.config/gcloud/**)",
      "Edit(~/.config/gcloud/**)",
      "Read(~/.config/rclone/**)",
      "Edit(~/.config/rclone/**)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Grep(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Grep(**/.env.*)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Grep(**/secrets/**)",
      "Read(~/.config/gh/**)",
      "Edit(~/.config/gh/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/Library/Keychains/**)",
      "Edit(~/Library/Keychains/**)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Grep(**/*.pem)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Grep(**/*.key)",
      "Read(**/id_rsa*)",
      "Edit(**/id_rsa*)",
      "Grep(**/id_rsa*)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "_dummy_key_Monitor"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "additionalDirectories": []
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [],
      "denyWrite": [],
      "denyRead": [],
      "allowRead": []
    },
    "credentials": {
      "envVars": [
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "AWS_SESSION_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" },
        { "name": "HOMEBREW_GITHUB_API_TOKEN", "mode": "deny" },
        { "name": "GEMINI_API_KEY", "mode": "deny" },
        { "name": "GOOGLE_API_KEY", "mode": "deny" },
        { "name": "GOOGLE_APPLICATION_CREDENTIALS", "mode": "deny" },
        { "name": "SLACK_TOKEN", "mode": "deny" },
        { "name": "SLACK_BOT_TOKEN", "mode": "deny" },
        { "name": "DATABASE_URL", "mode": "deny" },
        { "name": "STRIPE_SECRET_KEY", "mode": "deny" },
        { "name": "STRIPE_API_KEY", "mode": "deny" },
        { "name": "SENTRY_AUTH_TOKEN", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "api.github.com"
      ]
    },
    "allowUnsandboxedCommands": false
  }
}
